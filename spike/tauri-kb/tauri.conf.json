{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyXtend spike Tauri",
  "version": "0.0.0",
  "identifier": "org.keyxtend.spike.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "kb",
        "create": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}

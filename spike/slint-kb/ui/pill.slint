// The selection pill: one Copy button next to selected text; it never takes focus.
import { Palette } from "std-widgets.slint";
import { Cap } from "cap.slint";

export component Pill inherits Window {
    in property <string> caption;
    in property <string> label;
    in property <length> pill-width;
    in property <length> pill-height;
    in property <length> font-px;
    callback copy();

    title: caption;
    no-frame: true;
    always-on-top: true;
    background: Palette.background;
    width: pill-width;
    height: pill-height;

    Cap {
        width: parent.width;
        height: parent.height;
        label: label;
        font-px: font-px;
        clicked => {
            copy();
        }
    }
}

// One clickable cap: a key, a tool button or the pill's button. Readers see a button with its label.
import { Palette } from "std-widgets.slint";

export component Cap inherits Rectangle {
    in property <string> label;
    in property <length> font-px;
    // Edge width; drawn in the text colour, so edges keep at least 3:1 contrast.
    property <length> edge: 1px;
    callback clicked();

    background: touch.pressed ? Palette.accent-background : Palette.control-background;
    border-width: edge;
    border-color: Palette.foreground;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        clicked();
    }

    Text {
        // The cap already carries the label; hide the text so readers say it once.
        accessible-role: none;
        width: parent.width;
        height: parent.height;
        text: label;
        font-size: font-px;
        color: touch.pressed ? Palette.accent-foreground : Palette.control-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
}

// The caption bar: what the mic hears, then the words it typed; it never takes focus.
import { Palette } from "std-widgets.slint";

export component CaptionBar inherits Window {
    in property <string> caption;
    in property <string> text;
    in property <length> font-px;
    in property <length> pad;
    // Edge width; drawn in the text colour, like the keys.
    property <length> edge: 1px;

    title: caption;
    no-frame: true;
    always-on-top: true;
    background: Palette.control-background;

    Rectangle {
        border-width: edge;
        border-color: Palette.foreground;

        Text {
            x: pad;
            width: parent.width - 2 * pad;
            height: parent.height;
            text: root.text;
            font-size: font-px;
            color: Palette.control-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

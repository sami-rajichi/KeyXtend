// P1 spike: the stage-1 keyboard. Plain look, no theme, no focusable widgets.
import { Palette } from "std-widgets.slint";
import { Cap } from "cap.slint";
export { Pill } from "pill.slint";
export { Overlay } from "overlay.slint";

// One key: its label, scan code and box from the client top-left, all from spike-core.
export struct Key {
    label: string,
    code: int,
    x: length,
    y: length,
    w: length,
    h: length,
}

// One tool button: its label and box; its index is what `tool` reports.
export struct Tool {
    label: string,
    x: length,
    y: length,
    w: length,
    h: length,
}

// The key block, a tools row and a status line under it; sized to fit, never scrolled.
export component Keyboard inherits Window {
    in property <string> caption;
    in property <[Key]> keys;
    in property <[Tool]> tools;
    in property <string> status;
    in property <length> face-width;
    in property <length> face-height;
    in property <length> gap-px;
    in property <length> font-px;
    callback tapped(int);
    callback tool(int);

    title: caption;
    always-on-top: true;
    background: Palette.background;
    width: face-width;
    height: face-height + line.height + gap-px;

    for key in keys: Cap {
        x: key.x;
        y: key.y;
        width: key.w;
        height: key.h;
        label: key.label;
        font-px: font-px;
        clicked => {
            tapped(key.code);
        }
    }

    for t[i] in tools: Cap {
        x: t.x;
        y: t.y;
        width: t.w;
        height: t.h;
        label: t.label;
        font-px: font-px;
        clicked => {
            tool(i);
        }
    }

    line := Text {
        x: gap-px;
        y: face-height;
        width: face-width - 2 * gap-px;
        height: self.preferred-height;
        text: status;
        font-size: font-px;
        color: Palette.foreground;
        overflow: elide;
    }
}

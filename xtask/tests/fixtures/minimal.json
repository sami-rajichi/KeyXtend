{
  "packages": [
    {
      "id": "path+file:///C:/repo/xtask#0.0.0",
      "name": "xtask",
      "manifest_path": "C:\\repo\\xtask\\Cargo.toml",
      "dependencies": [
        { "name": "serde", "kind": null, "features": ["derive"] },
        { "name": "proptest", "kind": "dev" }
      ],
      "targets": [
        { "kind": ["bin"], "src_path": "C:\\repo\\xtask\\src\\main.rs" }
      ],
      "features": { "default": ["std"], "std": [] }
    }
  ],
  "workspace_members": ["path+file:///C:/repo/xtask#0.0.0"],
  "workspace_root": "C:\\repo",
  "resolve": {
    "nodes": [
      {
        "id": "path+file:///C:/repo/xtask#0.0.0",
        "features": ["default"],
        "deps": [
          {
            "pkg": "registry+https://github.com/rust-lang/crates.io-index#serde@1.0.229",
            "dep_kinds": [{ "kind": null }]
          }
        ]
      }
    ]
  },
  "metadata": {
    "tidy": {
      "max_file_lines": 400,
      "warn_file_lines": 300,
      "extensions": ["rs", "slint", "qml"],
      "scan_dirs": ["apps", "crates", "tools", "xtask"],
      "skip_dirs": ["target"],
      "app_dir": "apps",
      "tool_dir": "tools",
      "build_tool": "xtask",
      "module_prefix": "kx-mod-",
      "platform_prefix": "kx-platform-",
      "module_allowed": ["kx-module-api"],
      "app": "keyxtend",
      "banned_network": ["reqwest", "hyper", "ureq", "rustls", "native-tls"],
      "banned_media": ["image", "symphonia", "hound", "lopdf", "ffmpeg-next", "gstreamer"],
      "banned_features": { "toml": ["unbounded"] },
      "build_only_features": { "kx-theme": ["files"] },
      "unsafe_attr": "#![forbid(unsafe_code)]",
      "deny_attr": "#![deny(unsafe_code)]",
      "root_kinds": ["lib", "bin", "proc-macro"],
      "test_only": ["kx-test-support", "kx-platform-fake"],
      "bridge_crate": "kx-ui",
      "bridge_dir": "src/bridges",
      "safety_tag": "// SAFETY:",
      "spawn_dirs": ["apps", "crates"],
      "spawn_extensions": ["rs", "h", "cpp"],
      "banned_spawns": ["std::process::Command", "QProcess"],
      "build_scripts": ["build.rs", "qtbuild.rs"]
    },
    "dco": {
      "trailer": "Signed-off-by",
      "exempt_authors": ["dependabot[bot]"]
    }
  }
}

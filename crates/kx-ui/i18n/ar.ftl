### النصوص العربية (ADR-0017) بمصطلحات Windows، والمفتاح الناقص يؤخذ من الإنجليزية؛
### الأرقام غربية (0-9)، والفاصلة وعلامة الاستفهام عربيتان: "،" و"؟".
### المفاتيح التي تُطبع عليها كلمة لاتينية تُسمّى "مفتاح" وتلك الكلمة، وما له مصطلح Microsoft يبقى عليه.

## اسم المنتج، يُكتب مرة واحدة وتستعمله النصوص التالية.
-app = KeyXtend

## المفاتيح المسماة حسب معرّفها في board.toml، ثم .empty لمفتاح لا يكتب شيئًا الآن: الاسم الذي تعرضه التلميحات وتنطقه قارئات الشاشة.
key =
    .esc = مفتاح Esc
    .bksp = مسافة للخلف
    .tab = مفتاح Tab
    .del = حذف
    .caps = تأمين الأحرف الكبيرة
    .enter = إدخال
    .shift = مفتاح Shift
    .rshift = مفتاح Shift الأيمن
    .up = سهم لأعلى
    .menu = مفتاح القائمة
    .ctrl = مفتاح Ctrl
    .win = مفتاح Windows
    .alt = مفتاح Alt
    .lang = اللغة
    .space = مسافة
    .altgr = مفتاح Alt Gr
    .left = سهم لليسار
    .down = سهم لأسفل
    .right = سهم لليمين
    .rclick = النقر بزر الماوس الأيمن بالضغط المطوّل
    .grab = إمساك: السحب والإفلات وتحديد النص
    .shortcuts = الاختصارات
    .mic = الكتابة الصوتية
    .clip = محفوظات الحافظة
    .snip = لقطة شاشة
    .fill = تعبئة سريعة
    .settings = الإعدادات
    .power = الطاقة
    .dpad = لوحة التمرير
    .empty = مفتاح فارغ

## الكلمة القصيرة على المفتاح أو تحت أيقونته في الأحجام الكبيرة؛ ما تطبعه لوحات المفاتيح العربية بالإنجليزية يبقى بالإنجليزية.
label =
    .esc = Esc
    .bksp = Back
    .tab = Tab
    .del = Del
    .caps = Caps
    .enter = Enter
    .shift = Shift
    .rshift = Shift
    .up = أعلى
    .menu = القائمة
    .ctrl = Ctrl
    .win = Win
    .alt = Alt
    .altgr = AltGr
    .left = يسار
    .down = أسفل
    .right = يمين
    .rclick = نقر أيمن
    .grab = إمساك
    .shortcuts = اختصارات
    .mic = إملاء
    .clip = الحافظة
    .snip = لقطة
    .fill = تعبئة
    .settings = الإعدادات
    .power = الطاقة

tip =
    .later = ستتوفّر هذه الميزة في إصدار لاحق
    .one-lang = لا يوجد سوى لغة واحدة مثبّتة للوحة المفاتيح
    .mouse-off = مساعد الماوس متوقّف
    .scroll-off = لوحة التمرير متوقّفة
    .rclick = اضغط مطوّلًا دون تحريك المؤشر للنقر بالزر الأيمن؛ أما النقرات القصيرة فتبقى عادية
    .grab = اضغط للإمساك، ثم حرّك، ثم انقر للإفلات

## أسماء الحركات العربية، تنطقها قارئات الشاشة للمفتاح الذي يكتبها؛ ويصل .join بين الحركات المكتوبة معًا.
mark =
    .fathatan = تنوين الفتح
    .dammatan = تنوين الضمّ
    .kasratan = تنوين الكسر
    .fatha = فتحة
    .damma = ضمّة
    .kasra = كسرة
    .shadda = شدّة
    .sukun = سكون
    .join = {" مع "}

## أزرار الشريط العلوي وزاوية تغيير الحجم والفقاعة، حسب معرّفها في [bar] من icons.toml.
bar =
    .grip = نقل لوحة المفاتيح: انقر، ثم حرّك، ثم انقر
    .mode = التبديل إلى الوضع الداكن
    .mode_on = التبديل إلى الوضع الفاتح
    .theme = تغيير السمة
    .smaller = أصغر
    .bigger = أكبر
    .minimise = تصغير إلى فقاعة
    .close = إخفاء لوحة المفاتيح
    .corner = تغيير الحجم: انقر، ثم حرّك، ثم انقر
    .bubble = إظهار لوحة المفاتيح

## الأحجام الجاهزة في الشريط العلوي بترتيب presets في [keyboard]: الحرف الظاهر على كل زر، ثم اسمه.
size =
    .s = ص
    .m = م
    .l = ك
sizename =
    .s = صغير
    .m = متوسط
    .l = كبير

## أسهم لوحة التمرير وزر الإيقاف، حسب معرّفها في [dpad] من icons.toml.
dpad =
    .up = التمرير لأعلى
    .right = التمرير لليمين
    .left = التمرير لليسار
    .down = التمرير لأسفل
    .stop = إيقاف التمرير

## فاتح أو داكن أو حسب Windows، حسب قيمة mode في [ui].
mode =
    .light = فاتح
    .dark = داكن
    .auto = تلقائي

## عناوين النوافذ التي تعلنها قارئات الشاشة.
window =
    .keyboard = لوحة مفاتيح { -app }
    .bubble = لوحة مفاتيح { -app } (مصغّرة)
    .notice = إشعار { -app }
    .menu = قائمة { -app }
    .list = لغات لوحة المفاتيح
    .tip = تلميح { -app }
    .pointer = مساعد المؤشر

## ما تعلنه قارئات الشاشة للغطاء الذي ينهي النقل أو تغيير الحجم.
catch = انقر لإنهاء النقل أو تغيير الحجم

## شارة الوضع بجانب المؤشر: كلمتها ما دام الإمساك يُبقي الضغطة.
badge =
    .holding = قيد الإمساك

tray =
    .show = إظهار لوحة المفاتيح
    .quit = إنهاء

## أزرار الإشعار.
button =
    .retry = إعادة المحاولة
    .ok = موافق

## شريط الإشعارات: كم إشعارًا آخر ينتظر خلف الإشعار المعروض.
## تُختار صيغة الجمع حسب $form، وهو $more كما تقرؤه قواعد CLDR؛ ولا تُبلغ صيغة الصفر لأن $more لا يقل عن 1.
banner =
    .more = { $form ->
        [one] إشعار آخر
        [two] إشعاران آخران
        [few] { $more } إشعارات أخرى
        [many] { $more } إشعارًا آخر
       *[other] { $more } إشعار آخر
    }

## القوائم المقسّمة إلى صفحات: زرّا الصفحات، ورقم الصفحة بينهما.
page =
    .back = الصفحة السابقة
    .on = الصفحة التالية
    .of = { $at } من { $count }

## الإشعارات حسب مفتاحها في kx-module-api: $module اسم وحدة، و$keys قائمة بأسماء إعدادات.
notice =
    .settings-reset = بعض إعدادات { $module } لم تكن صالحة، فعادت إلى قيمها الافتراضية: { $keys }.
    .settings-restored = كان ملف الإعدادات تالفًا، فاستُعيدت آخر نسخة سليمة منه.
    .settings-defaults = تعذّر استخدام أي ملف إعدادات، لذا تُستخدم الإعدادات الافتراضية.
    .settings-newer = إعدادات { $module } من إصدار أحدث. تم الاحتفاظ بها، وتُستخدم القيم الافتراضية حاليًا.
    .settings-unsaved = تعذّر حفظ الإعدادات، لذا تبقى التغييرات حتى إغلاق لوحة المفاتيح فقط.
    .settings-locked = يستخدم برنامج آخر ملف الإعدادات. تُستخدم الإعدادات الافتراضية، ولن يُحفظ أي شيء.
    .module-failed = أدّى خطأ إلى إيقاف { $module }. باقي الميزات تعمل كالمعتاد.
    .keys-not-sent = لم تصل بعض المفاتيح إلى التطبيق النشط. تحقّق مما كُتب.
    .lang-not-switched = تعذّر على التطبيق النشط تبديل اللغة.
    .mouse-hook-failed = تعذّر تشغيل مساعد الماوس لأن Windows رفض السماح له بمراقبة الماوس. اضغط على المفتاح مرة أخرى.
    .mouse-reset = واجه مساعد الماوس خطأً، فأُوقف تشغيل أوضاعه. اضغط على مفتاح أحد الأوضاع لتشغيله مرة أخرى.
    .mouse-stopped = توقّف مساعد الماوس بسبب خطأ. أعد تشغيل { -app } لاستخدامه مرة أخرى.
    .scroll-point = أشِر إلى ما تريد تمريره، ثم اضغط على سهم.
    .scroll-none = لا يوجد ما يمكن تمريره هنا.
    .scroll-end = وصلت إلى النهاية بالفعل.
    .scroll-failed = واجهت لوحة التمرير خطأً. اضغط على سهم للمحاولة مرة أخرى.
    .scroll-stopped = توقّفت لوحة التمرير بسبب خطأ. أعد تشغيل { -app } لاستخدامها مرة أخرى.

## أسماء الوحدات حسب معرّفها، والمعرّف غير المذكور يظهر كما هو.
module =
    .kernel = { -app }
    .keyboard = لوحة المفاتيح
    .layouts = تخطيطات لوحة المفاتيح
    .mouse = مساعد الماوس
    .scroll = لوحة التمرير
    .ui = المظهر

## أشكال مفتاح اللغة حسب قيمة lang_key في [keyboard].
langkey =
    .carousel = عرض دوّار
    .cycle = تناوب
    .list = قائمة

## شريط المسافة: اللغة ثم التخطيط.
lang =
    .space = { $lang } · { $layout }

## أسماء السمات حسب معرّفها في themes.toml: تبقى أسماء الطُرز، وتُترجم الكلمات العادية.
theme =
    .native = الأصلي المتكيّف
    .et66 = ET66
    .dolch = دولش الحديث

## القوائم: ما يفصل بين عنصرين، ونهاية قائمة أُغفل منها $more إعداد، وقائمة لا تسمّي شيئًا؛ القائمة الوحيدة اليوم أسماء إعدادات.
## تُختار صيغة الجمع حسب $form، وهو $more كما تقرؤه قواعد CLDR؛ ولا تُبلغ صيغة الصفر لأن $more لا يقل عن 1.
list =
    .join = {" و "}
    .more = { $list } { $form ->
        [one] وإعداد آخر
        [two] وإعدادان آخران
        [few] و{ $more } إعدادات أخرى
        [many] و{ $more } إعدادًا آخر
       *[other] و{ $more } إعداد آخر
    }
    .count = { $form ->
        [one] إعداد واحد
        [two] إعدادان
        [few] { $more } إعدادات
        [many] { $more } إعدادًا
       *[other] { $more } إعداد
    }
